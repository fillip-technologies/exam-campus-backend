{
  "name": "exam-campus-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait mysql",
    "db:down": "docker compose down",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.1",
    "@fastify/etag": "6.2.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/jwt": "10.2.7",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/sensible": "6.0.7",
    "@fastify/static": "10.1.10",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
