# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Local MariaDB/MySQL on this machine (see README "Database setup").
# Production target is MySQL 8; docker-compose.yml has an optional MySQL 8.4 container on port 3307.
DATABASE_URL=mysql://examcampus:CHANGE_ME@127.0.0.1:3306/examcampus
# Only used by `prisma migrate dev` (development).
SHADOW_DATABASE_URL=mysql://examcampus:CHANGE_ME@127.0.0.1:3306/examcampus_shadow

# Origins allowed to call the API with credentials (comma-separated). The frontend is hosted separately.
CORS_ORIGINS=http://localhost:5173

# Auth. JWT_SECRET: at least 32 random characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Cookie domain when the API is on a subdomain (api.examcampus.in -> .examcampus.in). Empty locally.
COOKIE_DOMAIN=
# OTP codes are printed in the server log until an SMS / email provider is chosen.
OTP_DELIVERY=log

# Files (media library: images + PDFs). STORAGE_DRIVER picks where NEW uploads go:
#   local      = the UPLOAD_DIR folder on this server, served by the API at PUBLIC_UPLOAD_URL
#   cloudinary = Cloudinary, served from its CDN (needs CLOUDINARY_URL)
# Switching is safe at any time: each file remembers where it was stored, files in UPLOAD_DIR are always served,
# and Cloudinary files stay deletable as long as CLOUDINARY_URL is set. Restart the API after changing it.
STORAGE_DRIVER=local
# Cloudinary console -> Settings -> API Keys -> "API environment variable". Keep it secret.
CLOUDINARY_URL=
# Folder in the Cloudinary media library; use one per environment (examcampus, examcampus-staging ...)
CLOUDINARY_FOLDER=examcampus
# local driver: folder on this server (relative to the API's working directory, or absolute).
# Back it up and keep it on a persistent disk (a container's filesystem is wiped on redeploy).
UPLOAD_DIR=uploads
# local driver: public URL of that folder. Required in production, e.g. https://api.examcampus.in/uploads
PUBLIC_UPLOAD_URL=http://localhost:4000/uploads
MAX_UPLOAD_MB=10

# Seed only: where the frontend repo is checked out, so `npm run db:seed` can import its src/data/* files.
FRONTEND_DIR=../exam-campus-frontend
